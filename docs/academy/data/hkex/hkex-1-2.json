      "blocks": [
        {
          "type": "point",
          "content_cn": "重要性｜披露有重要影响的事宜｜评估标准不清晰、持份者参与不足｜制定明确评估准则、覆盖关键群体",
          "provenance": "knowledge_note"
        },
        {
          "type": "point",
          "content_cn": "量化｜KPI可计量、设目标｜数据不可比、缺基线数据｜建立数据收集体系、设定基线",
          "provenance": "knowledge_note"
        },
        {
          "type": "point",
          "content_cn": "平衡｜不偏不倚呈报表现｜报喜不报忧、回避负面信息｜建立负面信息披露机制、客观陈述",
          "provenance": "knowledge_note"
        },
        {
          "type": "point",
