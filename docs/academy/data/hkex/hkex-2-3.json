  "sections": [
    {
      "title": "目标设定概述",
      "blocks": [
        {
          "type": "text",
          "content_cn": "ESG目标设定是推动企业持续改进的重要机制。目标应遵循 SMART原则 ，明确具体、可衡量、可实现、相关且有时限。",
          "provenance": "knowledge_note"
        },
        {
          "type": "text",
          "content_cn": "对于难以量化的目标，可采用 方向性声明 ，描述努力方向和预期成果，并分阶段设定里程碑。",
          "provenance": "knowledge_note"
        },
        {
          "type": "text",
          "content_cn": "目标设定后须建立 跟踪机制 ，定期评估进展，在ESG报告中披露目标完成情况。",
          "provenance": "knowledge_note"
        }
      ]
    },
