      "blocks": [
        {
          "type": "point",
          "content_cn": "目标内容｜明确目标涉及的领域和具体内容｜减少范围1温室气体排放",
          "provenance": "knowledge_note"
        },
        {
          "type": "point",
          "content_cn": "基线数据｜目标设定时的基准数据｜2023年范围1排放10,000吨CO2e",
          "provenance": "knowledge_note"
        },
        {
          "type": "point",
          "content_cn": "目标值｜希望达到的具体数值｜2030年减少30%至7,000吨",
