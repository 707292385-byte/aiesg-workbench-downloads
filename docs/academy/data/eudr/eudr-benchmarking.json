              "尽调系统",
              "程序、责任、风险标准和年度复核"
            ],
            [
              "批次追溯",
              "地块—商品—批次—声明编号链"
            ],
            [
              "监管响应",
              "文件索引、联系人、纠正和召回预案"
            ]
          ],
          "provenance": "knowledge_note"
        }
      ]
    }
