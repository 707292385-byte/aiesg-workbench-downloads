          "layout": "h",
          "steps": [
            {
              "title": "2023-08-17",
              "desc": "法规生效。"
            },
            {
              "title": "2024-02-18",
              "desc": "多数一般条款开始适用。"
            },
            {
              "title": "2025-08-18",
              "desc": "旧电池指令原则上废止，生产者责任等进入新框架。"
            },
            {
              "title": "2027-02-18",
              "desc": "便携式/LMT电池可拆换要求开始适用。"
            },
            {
              "title": "2027-02-18",
              "desc": "电池护照适用于 LMT、工业电池>2kWh 和电动汽车电池。"
            },
            {
              "title": "2027-08-18",
              "desc": "电池供应链尽调开始适用。"
            }
          ],
          "provenance": "knowledge_note",
          "source": "Regulation (EU) 2023/1542; 2025/1561"
        }
      ]
    },
