  {
   "id": "c-34",
   "title": "2-3-a 和 2-3-b 指南",
   "groupTitle": "标准正文",
   "learningLayer": "original",
   "blocks": [
    {
     "type": "standard",
     "content_cn": "报告期是指报告信息所对应的时间段，宜包括开始和结束日期（例如，2022年1月1日至2022年12月31日，2022年7月1日至2023年6月30日）。\n\n组织报告的信息宜与财务报告属同一报告期。如果可能，组织还宜与财务报告同时发布信息。",
     "title": "2-3-a和2-3-b指南",
     "source": "GRI 2（2021）官方中文版",
     "sourceScope": "official",
     "provenance": "official",
     "language": "zh",
     "learningLayer": "original"
    }
   ]
