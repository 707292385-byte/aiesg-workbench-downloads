  {
   "id": "c-142",
   "title": "2-24-a-i 指南",
   "groupTitle": "标准正文",
   "learningLayer": "original",
   "blocks": [
    {
     "type": "card_grid",
     "cards": [
      {
       "title": "组织内不同层级的示例包括最高管治机构、高管以及运营层级。 组织可报告",
       "content": "",
       "items": [
        "对履行政策承诺进行监督或问责的最高层级；"
       ]
      }
     ],
     "numbered": false,
     "title": "2-24-a-i指南",
     "source": "GRI 2（2021）官方中文版",
     "sourceScope": "official",
     "provenance": "official",
     "language": "zh",
     "learningLayer": "original"
    },
    {
     "type": "card_grid",
     "cards": [
      {
       "title": "",
       "content": "组织中对履行每项政策承诺负有日常责任的职能部门（例如，人力资源部负责履行尊重工作者权•利的承诺），包括： \\- 他们对高级决策层的汇报关系； \\- 将责任分配给他们的原因；",
       "items": [
        "负责任商业行为是否在最高管治机构或高管的会议上正式讨论，如果是，讨论了哪些议题；"
       ],
       "after": "是否有其他正式或系统性方法，以在组织内不同层级或职能部门之间讨论负责任商业行为（例如，跨职能工作组）。"
      }
     ],
     "numbered": false,
