   "groupTitle": "标准正文",
   "learningLayer": "original",
   "blocks": [
    {
     "type": "standard",
     "content_cn": "组织可将可持续发展报告的报告频率定为“年度”。参见 ，了解更多信息。",
     "title": "2-3-a指南",
     "source": "GRI 2（2021）官方中文版",
     "sourceScope": "official",
