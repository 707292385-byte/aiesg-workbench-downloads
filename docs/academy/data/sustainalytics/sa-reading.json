          "type": "card_grid",
          "cards": [
            {
              "title": "可比",
              "content": "绝对档位，可跨子行业比较风险高低。"
            },
            {
              "title": "谨慎",
              "content": "同档内 1–2 分差异通常不具实质意义。"
            },
            {
              "title": "看构成",
              "content": "要判断风险来自敞口还是管理缺口，需看议题级分解。"
