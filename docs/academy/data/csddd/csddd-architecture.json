            },
            {
              "title": "环境影响",
              "content": "附录所列环境义务与禁止行为，包括污染、生物多样性等影响。"
            },
            {
              "title": "实际与潜在",
              "content": "既管已经发生的损害，也管尚未发生但具有风险的影响。"
            }
